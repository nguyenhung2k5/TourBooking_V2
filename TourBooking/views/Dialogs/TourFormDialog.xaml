<Window x:Class="TourBooking.Views.Dialogs.TourFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Form Quản lý Tour du lịch" Height="550" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8F9FA" FontFamily="Segoe UI">

    <Border Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtHeaderTitle" Grid.Row="0" Text="Nhập thông tin Tour du lịch" FontSize="20" FontWeight="Bold" Foreground="#101828" Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MÃ TOUR" FontSize="12" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtTourCode" Height="38" Padding="10,8" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ĐIỂM ĐẾN" FontSize="12" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtDestination" Height="38" Padding="10,8" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="TÊN TOUR" FontSize="12" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTourName" Height="38" Padding="10,8" FontSize="13"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="NGÀY KHỞI HÀNH" FontSize="12" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4"/>
                            <DatePicker Language="vi-VN" x:Name="dpDepartureDate" Height="38" Padding="10,6" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="NGÀY VỀ" FontSize="12" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4"/>
                            <DatePicker Language="vi-VN" x:Name="dpReturnDate" Height="38" Padding="10,6" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GIÁ VÉ NGƯỜI LỚN (VNĐ)" FontSize="12" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtPriceAdult" Height="38" Padding="10,8" FontSize="13" Text="3500000"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="GIÁ VÉ TRẺ EM (VNĐ)" FontSize="12" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtPriceChild" Height="38" Padding="10,8" FontSize="13" Text="1500000"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="SỐ CHỖ TỐI ĐA" FontSize="12" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTotalSlots" Height="38" Padding="10,8" FontSize="13" Text="20"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy bỏ" Click="BtnCancel_Click" Width="100" Height="40" Background="#F2F4F7" Foreground="#344054" FontWeight="SemiBold" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
                <Button Content="Lưu dữ liệu" Click="BtnSave_Click" Width="120" Height="40" Background="#1D3D8F" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
