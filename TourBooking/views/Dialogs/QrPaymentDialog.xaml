<Window x:Class="TourBooking.Views.Dialogs.QrPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán qua QR" Height="500" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock Text="QUÉT MÃ THANH TOÁN QR" FontSize="16" FontWeight="Bold" Foreground="#1D3D8F" HorizontalAlignment="Center"/>
            <TextBlock Text="Vui lòng chuyển đúng số tiền và nội dung chuyển khoản bên dưới" FontSize="11" Foreground="#667085" HorizontalAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Image x:Name="imgQrCode" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280" MaxHeight="280"/>
                
                <StackPanel Grid.Row="1" Margin="0,15,0,0">
                    <TextBlock x:Name="txtAmount" Text="Số tiền: 0 đ" FontSize="18" FontWeight="Bold" Foreground="#12B76A" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtBookingCode" Text="Nội dung: BK-XXXXXXXX" FontSize="13" FontWeight="SemiBold" Foreground="#101828" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Hủy bỏ" Width="120" Height="38" Click="BtnCancel_Click" Margin="0,0,15,0" Background="White" BorderBrush="#D0D5DD"/>
            <Button Content="Xác nhận đã chuyển" Width="180" Height="38" Click="BtnConfirm_Click" Background="#1D3D8F" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
