<Window x:Class="TourBooking.Views.Dialogs.ReportExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xuất báo cáo hệ thống" Height="420" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8F9FA" FontFamily="Segoe UI">

    <Border Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="📥 Xuất báo cáo hệ thống" FontSize="20" FontWeight="Bold" Foreground="#101828"/>
                <TextBlock Text="Chọn loại báo cáo bạn muốn kết xuất dữ liệu ra file Excel / CSV." FontSize="13" Foreground="#667085" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <RadioButton x:Name="rbTour" Content="📊 Báo cáo Quản lý Tour du lịch" FontSize="14" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,14" IsChecked="True"/>
                <RadioButton x:Name="rbBooking" Content="🛒 Báo cáo Quản lý Đơn hàng (Bookings)" FontSize="14" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,14"/>
                <RadioButton x:Name="rbStaff" Content="👥 Báo cáo Quản lý Nhân sự" FontSize="14" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,14"/>
                <RadioButton x:Name="rbCustomer" Content="🧑‍💼 Báo cáo Quản lý Khách hàng" FontSize="14" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,14"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Đóng" Click="BtnCancel_Click" Width="100" Height="40" Background="#F2F4F7" Foreground="#344054" FontWeight="SemiBold" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
                <Button Content="📥 Xuất File CSV" Click="BtnExport_Click" Width="140" Height="40" Background="#1D3D8F" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
