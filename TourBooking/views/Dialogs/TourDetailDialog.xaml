<Window x:Class="TourBooking.Views.Dialogs.TourDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:TourBooking.Helpers"
        Title="Chi Tiết Tour Du Lịch" Height="550" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8F9FA" FontFamily="Segoe UI">

    <Window.Resources>
        <helpers:NumberFormatConverter x:Key="MoneyConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1D3D8F" Padding="20,15">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📋 THÔNG TIN CHI TIẾT TOUR DU LỊCH" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Mã định danh và thông số hành trình toàn diện" Foreground="#A3B8CC" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25">
            <StackPanel>
                <!-- CARD 1: OVERVIEW -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#E2E8F0" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="TÊN CHƯƠNG TRÌNH" FontSize="11" FontWeight="Bold" Foreground="#667085"/>
                            <TextBlock x:Name="txtTourName" FontSize="18" FontWeight="Bold" Foreground="#101828" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MÃ TOUR" FontSize="11" FontWeight="Bold" Foreground="#667085"/>
                                <TextBlock x:Name="txtTourCode" FontSize="15" FontWeight="Bold" Foreground="#1D3D8F" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ĐIỂM ĐẾN" FontSize="11" FontWeight="Bold" Foreground="#667085"/>
                                <TextBlock x:Name="txtDestination" FontSize="15" FontWeight="SemiBold" Foreground="#101828" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 2: DATES & SLOTS -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#E2E8F0" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NGÀY KHỞI HÀNH" FontSize="11" FontWeight="Bold" Foreground="#667085"/>
                                <TextBlock x:Name="txtDepartureDate" FontSize="14" FontWeight="SemiBold" Foreground="#101828" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="NGÀY VỀ" FontSize="11" FontWeight="Bold" Foreground="#667085"/>
                                <TextBlock x:Name="txtReturnDate" FontSize="14" FontWeight="SemiBold" Foreground="#101828" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TỔNG SỐ CHỖ" FontSize="11" FontWeight="Bold" Foreground="#667085"/>
                                <TextBlock x:Name="txtTotalSlots" FontSize="14" FontWeight="SemiBold" Foreground="#101828" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CHỖ CÒN TRỐNG" FontSize="11" FontWeight="Bold" Foreground="#667085"/>
                                <TextBlock x:Name="txtAvailableSlots" FontSize="14" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 3: PRICES & STATUS -->
                <Border Background="White" CornerRadius="8" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#E2E8F0" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="GIÁ VÉ NGƯỜI LỚN" FontSize="11" FontWeight="Bold" Foreground="#667085"/>
                                <TextBlock x:Name="txtPriceAdult" FontSize="15" FontWeight="Bold" Foreground="#101828" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GIÁ VÉ TRẺ EM" FontSize="11" FontWeight="Bold" Foreground="#667085"/>
                                <TextBlock x:Name="txtPriceChild" FontSize="15" FontWeight="Bold" Foreground="#667085" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="TRẠNG THÁI HOẠT ĐỘNG" FontSize="11" FontWeight="Bold" Foreground="#667085"/>
                            <TextBlock x:Name="txtStatus" FontSize="14" FontWeight="Bold" Foreground="#12B76A" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#EAECF0" BorderThickness="0,1,0,0" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnBookNow" Content="🛒 Đặt tour này ngay" Width="150" Height="40" Background="#12B76A" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnBookNow_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Đóng" Width="100" Height="40" Background="#EEF2F6" Foreground="#344054" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
