<UserControl x:Class="TourBooking.Views.Admin.AdminTourView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:TourBooking.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="#F4F6F9"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <helpers:NumberFormatConverter x:Key="MoneyConverter"/>

        <Style TargetType="Border" x:Key="CardBorder">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#E2E8F0" Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style dùng để căn giữa dọc hợp lệ cho TextBlock bên trong các cột TextColumn -->
        <Style x:Key="CenterTextColumnStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Grid Grid.Row="0" Margin="10,0,10,15">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Quản Lý Tour" FontSize="24" FontWeight="Bold" Foreground="#101828"/>
                <TextBlock Text="Quản lý và điều hành các chương trình du lịch hiện hành." FontSize="13" Foreground="#667085" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Xuất CSV" Background="White" Foreground="#344054" BorderBrush="#D0D5DD" BorderThickness="1" FontWeight="SemiBold" Padding="18,10" Margin="0,0,12,0" Command="{Binding ExportCsvCommand}"/>
                <Button Content="Thêm Tour Mới" Background="#0A1942" Foreground="White" FontWeight="Bold" Padding="18,10" Command="{Binding AddTourCommand}"/>
            </StackPanel>
        </Grid>

        <!-- KPI TILES -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
            <Border Style="{StaticResource CardBorder}" Padding="15">
                <StackPanel>
                    <TextBlock Text="TỔNG SỐ TOUR" Foreground="#667085" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalTours}" FontSize="24" FontWeight="Bold" Foreground="#101828" Margin="0,6"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="15">
                <StackPanel>
                    <TextBlock Text="ĐANG HOẠT ĐỘNG" Foreground="#667085" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ActiveTours}" FontSize="24" FontWeight="Bold" Foreground="#101828" Margin="0,6"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="15">
                <StackPanel>
                    <TextBlock Text="TỶ LỆ LẤP ĐẦY" Foreground="#667085" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding FillRate, StringFormat='{}{0}%'}" FontSize="24" FontWeight="Bold" Foreground="#101828" Margin="0,6"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="15">
                <StackPanel>
                    <TextBlock Text="TOUR ĐANG KHÓA" Foreground="#667085" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding InactiveTours, StringFormat='{}{0:D2}'}" FontSize="24" FontWeight="Bold" Foreground="#C62828" Margin="0,6"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- SPLIT GRID LAYOUT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7.3*"/>
                <ColumnDefinition Width="2.7*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT CONTAINER: DATAGRID -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="15">
                <DataGrid ItemsSource="{Binding ToursList}" Background="Transparent" BorderThickness="0" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAECF0" HeadersVisibility="Column" RowHeight="55">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#667085"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <!-- Đã sửa: Thay VerticalAlignment trực tiếp bằng ElementStyle -->
                        <DataGridTextColumn Header="Mã Tour" Binding="{Binding TourCode}" Width="1.2*" FontWeight="Bold" Foreground="#1D3D8F" ElementStyle="{StaticResource CenterTextColumnStyle}"/>

                        <DataGridTemplateColumn Header="Tên Chương Trình" Width="2.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding TourName}" FontWeight="Bold" Foreground="#101828" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Đã sửa: Thay VerticalAlignment trực tiếp bằng ElementStyle -->
                        <DataGridTextColumn Header="Điểm Đến" Binding="{Binding Destination}" Width="1.3*" ElementStyle="{StaticResource CenterTextColumnStyle}"/>
                        <DataGridTextColumn Header="Khởi Hành" Binding="{Binding DepartureDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="1.2*" ElementStyle="{StaticResource CenterTextColumnStyle}"/>

                        <DataGridTemplateColumn Header="Chỗ Trống" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AvailableSlots}" FontWeight="Bold" Foreground="#2E7D32"/>
                                        <TextBlock Text="{Binding TotalSlots, StringFormat=' / {0}'}" Foreground="#667085"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Đã sửa: Thay VerticalAlignment trực tiếp bằng ElementStyle -->
                        <DataGridTextColumn Header="Giá Vé" Binding="{Binding PriceAdult, Converter={StaticResource MoneyConverter}}" Width="1.3*" FontWeight="SemiBold" ElementStyle="{StaticResource CenterTextColumnStyle}"/>

                        <DataGridTemplateColumn Header="Thao Tác" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Sửa" Background="Transparent" Foreground="#1D3D8F" BorderThickness="0" Command="{Binding DataContext.EditTourCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="0,0,5,0" Cursor="Hand"/>
                                        <Button Content="Xóa" Background="Transparent" Foreground="#C62828" BorderThickness="0" Command="{Binding DataContext.DeleteTourCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- RIGHT CONTAINER: SIDE WIDGETS -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Lịch khởi hành gần nhất" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding UpcomingTours}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8F9FA" Padding="10" Margin="0,4" CornerRadius="4">
                                        <TextBlock Text="{Binding TourName}" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="#0A1942" CornerRadius="8" Margin="10" Padding="20">
                    <TextBlock Text="Thông Báo Hệ Thống" Foreground="White" FontSize="16" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>