<Window x:Class="TourBooking.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="loginWindow"
        Title="Đăng nhập hệ thống" Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border CornerRadius="12" Margin="30" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#E2E8F0" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.2*"/>
                <ColumnDefinition Width="5.8*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="12,0,0,12" Padding="35">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0.0"/>
                        <GradientStop Color="#1E293B" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TourBooking" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Giải pháp quản lý du lịch chuyên nghiệp" 
                                   Foreground="White" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" LineHeight="34"/>
                        <TextBlock Text="Hệ thống tích hợp tối ưu hóa quy trình vận hành và quản lý tour cho doanh nghiệp lữ hành hiện đại." 
                                   Foreground="#94A3B8" FontSize="13.5" Margin="0,15,0,0" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="2" Columns="2" Rows="1" Margin="0,0,0,5"/>
                </Grid>
            </Border>

          
            <Grid Grid.Column="1" Margin="50,35,50,35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,10,0,25">
                    <TextBlock Text="Đăng nhập hệ thống" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Vui lòng nhập thông tin tài khoản của bạn" FontSize="13.5" Foreground="#64748B" Margin="0,6,0,0"/>
                </StackPanel>

               
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="TÊN ĐĂNG NHẬP / EMAIL" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                    <Grid>
                        <TextBox x:Name="txtUsername" Padding="12,2,10,2" FontSize="14" Foreground="#0F172A" BorderBrush="#CBD5E1" Height="40" VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        
                    </Grid>
                </StackPanel>

                
                <StackPanel Grid.Row="2" Margin="0,0,0,18">
                    <TextBlock Text="MẬT KHẨU" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                    <Grid>
                        <PasswordBox x:Name="txtPassword" Padding="12,2,10,2" FontSize="14" Foreground="#0F172A" BorderBrush="#CBD5E1" Height="40" VerticalContentAlignment="Center">
                            <PasswordBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </PasswordBox.Resources>
                        </PasswordBox>
                        
                    </Grid>
                </StackPanel>

                
                <Grid Grid.Row="3" Margin="0,0,0,22">
                    <CheckBox Content="Ghi nhớ đăng nhập" FontSize="13" Foreground="#475569" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Quên mật khẩu?" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                </Grid>

                
                <Button Grid.Row="4" Click="BtnLogin_Click" Background="#2563EB" BorderThickness="0" Foreground="White" Height="42" FontSize="14" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                
                <Border Grid.Row="6" Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="#475569" TextWrapping="Wrap" LineHeight="17">
                            Nếu gặp sự cố truy cập, vui lòng liên hệ <Run FontWeight="SemiBold" Foreground="#0F172A">Admin kỹ thuật</Run>.
                        </TextBlock>
                    </Grid>
                </Border>

                
                <TextBlock Grid.Row="7" Text="© 2026 Net Tour Booking Enterprise. All rights reserved." FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Left"/>
            </Grid>
        </Grid>
    </Border>
</Window>
