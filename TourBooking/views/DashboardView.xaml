<UserControl x:Class="TourBooking.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="#F4F6F9"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
SnapsToDevicePixels="True"
TextOptions.TextFormattingMode="Display"
RenderOptions.BitmapScalingMode="HighQuality"
             >
    <UserControl.Resources>
        <Style TargetType="Border" x:Key="CardBorder">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#E2E8F0" Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SidebarMenuButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="12,4,12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,0,16,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAECF0"/>
                    <Setter Property="Foreground" Value="#1D3D8F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SidebarMenuButtonActive" BasedOn="{StaticResource SidebarMenuButton}">
            <Setter Property="Background" Value="#2448A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D3D8F"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#EAECF0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,24,16,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" Background="#1D3D8F" CornerRadius="6" Margin="0,0,12,0">
                        <Path Data="M14.4,6L14,4H5V21H7V14H12.4L12.8,16H20V6H14.4M18,14H14.2L13.8,12H7V6H12.2L12.6,8H18V14Z" Fill="White" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="TourBooking" FontSize="16" FontWeight="Bold" Foreground="#101828"/>
                        <TextBlock Text="Nhân Viên" FontSize="12" Foreground="#667085" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource SidebarMenuButtonActive}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,4H10V10H4V4M4,14H10V20H4V14M14,4H20V10H14V4M14,14H20V20H14V14Z" Fill="White" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Bảng điều khiển" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarMenuButton}" Click="BtnTourSearch_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L19.71,19L18.3,20.41L13.03,15.14C11.89,16.11 10.41,16.7 9.5,16.7A6.5,6.5 0 0,1 3,10.2A6.5,6.5 0 0,1 9.5,3M9.5,5A4.5,4.5 0 0,0 5,9.5A4.5,4.5 0 0,0 9.5,14A4.5,4.5 0 0,0 14,9.5A4.5,4.5 0 0,0 9.5,5Z" Fill="#667085" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tra cứu Tour" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarMenuButton}" Click="BtnBookingCreate_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M13,7H11V11H7V13H11V17H13V13H17V11H13V7M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 22,12A8,8 0 0,1 12,20Z" Fill="#667085" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tạo đặt chỗ" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarMenuButton}" Click="BtnOrderManagement_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,5.17L18.83,12L12,18.83L5.17,12L12,5.17M12,2L2,12L12,22L22,12L12,2Z" Fill="#667085" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Quản lý Đơn hàng" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Row="2" Style="{StaticResource SidebarMenuButton}" Margin="12,0,12,24" Click="BtnLogout_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M14.08,15.59L16.67,13H7V11H16.67L14.08,8.41L15.5,7L20.5,12L15.5,17L14.08,15.59M19,3A2,2 0 0,1 21,5V7H19V5H5V19H19V17H21V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V5A2,2 0 0,1 5,3H19Z" Fill="#667085" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Đăng xuất" FontSize="14" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        
        <Grid Grid.Column="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            
            <Grid Grid.Row="0" Margin="10,0,10,15">
                <TextBlock x:Name="txtHeaderStaffName" Text="{Binding StaffName, StringFormat='Chào buổi sáng, {0}'}" FontSize="22" FontWeight="Bold" Foreground="#101828" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnBell" Background="Transparent" BorderBrush="Transparent" Margin="0,0,15,0" Cursor="Hand" Click="BtnBell_Click">
                        <Grid>
                            <Path Data="M12,22A2,2 0 0,0 14,20H10A2,2 0 0,0 12,22M18,16V11C18,7.93 16.36,5.36 13.5,4.68V4A1.5,1.5 0 0,0 12,2.5A1.5,1.5 0 0,0 10,4V4.68C7.14,5.36 5.5,7.92 5.5,11V16L3.5,18V19H20V18L18,16Z" Fill="#667085" Width="20" Height="20"/>
                            <Ellipse Width="8" Height="8" Fill="#F04438" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"/>
                        </Grid>
                    </Button>
                    <Popup x:Name="popNotifications" PlacementTarget="{Binding ElementName=btnBell}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" CornerRadius="8" BorderBrush="#EAECF0" BorderThickness="1" Width="340" Margin="0,5,15,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="5" Color="#101828" Opacity="0.15"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <Border Grid.Row="0" BorderBrush="#EAECF0" BorderThickness="0,0,0,1" Padding="15,12" Background="#F8F9FA">
                                    <Grid>
                                        <TextBlock Text="🔔 Thông báo hệ thống" FontWeight="Bold" FontSize="13" Foreground="#101828"/>
                                        <TextBlock Text="Đóng" FontSize="12" FontWeight="SemiBold" Foreground="#1D3D8F" HorizontalAlignment="Right" Cursor="Hand" MouseDown="CloseNotifications_Click"/>
                                    </Grid>
                                </Border>
                                
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Notifications}" MaxHeight="300" Padding="10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F2F4F7" BorderThickness="0,0,0,1" Padding="5,10" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="#344054" LineHeight="18"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Popup>
                    <TextBlock x:Name="txtProfileStaffName" Text="{Binding StaffName}" VerticalAlignment="Center" FontSize="14" Foreground="#344054" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            
            <Border Grid.Row="1" Background="#1D3D8F" CornerRadius="8" Margin="10,0,10,10" Padding="30">
                <StackPanel HorizontalAlignment="Center" Width="700">
                    <TextBlock Text="Tra cứu nhanh đơn đặt chỗ" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtSearch" Padding="40,12,15,12" FontSize="14" BorderThickness="0" Height="46">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4,0,0,4"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L19.71,19L18.3,20.41L13.03,15.14C11.89,16.11 10.41,16.7 9.5,16.7A6.5,6.5 0 0,1 3,10.2A6.5,6.5 0 0,1 9.5,3M9.5,5A4.5,4.5 0 0,0 5,9.5A4.5,4.5 0 0,0 9.5,14A4.5,4.5 0 0,0 14,9.5A4.5,4.5 0 0,0 9.5,5Z" Fill="#667085" Width="18" Height="18" HorizontalAlignment="Left" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Background="#0A1942" Foreground="White" FontWeight="Bold" Padding="25,0" Content="Tìm kiếm →" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="0,4,4,0"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <TextBlock Foreground="#A3B8CC" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7.3*"/>
                    <ColumnDefinition Width="2.7*"/>
                </Grid.ColumnDefinitions>

                
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    
                    <UniformGrid Grid.Row="0" Columns="3">
                        <Border Style="{StaticResource CardBorder}" Padding="15">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Tổng số chương trình Tour" Foreground="#667085" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="txtTotalTickets" Text="{Binding TotalTours}" FontSize="26" FontWeight="Bold" Foreground="#101828" Margin="0,6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="15">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Tổng doanh thu ước tính" Foreground="#667085" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="txtTodayRevenue" Text="{Binding MonthRevenue, StringFormat={}{0:N0} đ}" FontSize="26" FontWeight="Bold" Foreground="#101828" Margin="0,6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="15">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Thời gian xử lý trung bình" Foreground="#667085" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="4.2 phút" FontSize="26" FontWeight="Bold" Foreground="#101828" Margin="0,6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <TextBlock Text="Giao dịch gần đây" FontSize="18" FontWeight="Bold" Foreground="#101828"/>
                                <TextBlock Text="Xem tất cả ↗" Foreground="#1D3D8F" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" PreviewMouseLeftButtonDown="BtnOrderManagement_Click"/>
                            </Grid>
                            <DataGrid Grid.Row="1" x:Name="dgRecentTransactions" ItemsSource="{Binding RecentBookings}" Background="Transparent" BorderThickness="0" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAECF0" HeadersVisibility="Column">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                        <Setter Property="Foreground" Value="#667085"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,12"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#EAECF0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Padding" Value="0,10"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding BookingCode}" Width="1.2*" FontWeight="Bold" Foreground="#1D3D8F"/>
                                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="2*"/>
                                    <DataGridTextColumn Header="Tour / Dịch vụ" Binding="{Binding TourName}" Width="2.5*"/>
                                    <DataGridTemplateColumn Header="Trạng thái" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding StatusBg}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Giá trị" Binding="{Binding TotalAmount, StringFormat={}{0:N0} đ}" Width="1.5*" FontWeight="SemiBold"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            
                            <Grid Grid.Row="2" Margin="0,15,0,0">
                                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#667085">
                                    <Run Text="Trang "/>
                                    <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="Bold" Foreground="#101828"/>
                                    <Run Text=" trên "/>
                                    <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="Bold" Foreground="#101828"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Trang trước" Command="{Binding PrevPageCommand}" Width="110" Height="34" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" Foreground="#344054" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                                        <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="Trang sau" Command="{Binding NextPageCommand}" Width="110" Height="34" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" Foreground="#344054" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Resources><Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

               
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="THAO TÁC NHANH" FontSize="12" FontWeight="Bold" Foreground="#667085" Margin="5,0,0,10"/>
                            <UniformGrid Columns="2" Rows="2">
                                <Button Background="#1D3D8F" Foreground="White" Height="52" Margin="4" BorderThickness="0" Cursor="Hand" Click="BtnBookingCreate_Click">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel>
                                        <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="White" Width="15" Height="15" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tạo mới" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Background="#EEF2F6" Foreground="#101828" Height="52" Margin="4" BorderThickness="0" Cursor="Hand" Click="BtnTourSearch_Click">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel>
                                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L19.71,19L18.3,20.41L13.03,15.14C11.89,16.11 10.41,16.7 9.5,16.7A6.5,6.5 0 0,1 3,10.2A6.5,6.5 0 0,1 9.5,3M9.5,5A4.5,4.5 0 0,0 5,9.5A4.5,4.5 0 0,0 9.5,14A4.5,4.5 0 0,0 14,9.5A4.5,4.5 0 0,0 9.5,5Z" Fill="#101828" Width="15" Height="15" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tra cứu Tour" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Background="#EEF2F6" Foreground="#101828" Height="52" Margin="4" BorderThickness="0" Cursor="Hand" Click="BtnOrderManagement_Click">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel>
                                        <Path Data="M12,5.17L18.83,12L12,18.83L5.17,12L12,5.17M12,2L2,12L12,22L22,12L12,2Z" Fill="#101828" Width="15" Height="15" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Đơn hàng" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Background="#EEF2F6" Foreground="#101828" Height="52" Margin="4" BorderThickness="0" Cursor="Hand" Click="BtnReportExport_Click">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel>
                                        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M8,12H16V14H8V12M8,16H16V18H8V16Z" Fill="#101828" Width="15" Height="15" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Xuất báo cáo" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="15,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="HIỆU SUẤT CÁ NHÂN" FontSize="12" FontWeight="Bold" Foreground="#667085" Margin="0,0,0,10"/>
                            
                            
                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Đơn hàng tháng này" FontSize="13" FontWeight="SemiBold" Foreground="#344054"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding MyBookingCount}" FontSize="13" FontWeight="Bold" Foreground="#1D3D8F"/>
                                        <TextBlock Text="/" FontSize="13" Foreground="#667085"/>
                                        <TextBlock Text="{Binding MyBookingTarget}" FontSize="13" Foreground="#667085"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Value="{Binding MyBookingCount, Mode=OneWay}" Maximum="{Binding MyBookingTarget, Mode=OneWay}" Height="6" Foreground="#1D3D8F" Background="#EAECF0" BorderThickness="0">
                                    <ProgressBar.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="3"/>
                                        </Style>
                                    </ProgressBar.Resources>
                                </ProgressBar>
                                <TextBlock Text="Mục tiêu tháng: 20 đơn hàng" FontSize="11" Foreground="#667085" Margin="0,4,0,0"/>
                            </StackPanel>
                            
                            
                            <StackPanel Grid.Row="2" Margin="0,0,0,4">
                                <TextBlock Text="Doanh thu mang lại (Tháng này)" FontSize="13" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,6"/>
                                <Border Background="#F8F9FA" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MyMonthRevenue, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" Foreground="#12B76A"/>
                                        <TextBlock Text="Cập nhật trực tiếp theo trạng thái đơn" FontSize="11" Foreground="#667085" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
